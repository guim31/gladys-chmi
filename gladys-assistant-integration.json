  "widgets": [
    {
      "key": "weather",
      "label": {
        "en": "ČHMÚ weather",
        "fr": "Météo ČHMÚ",
        "de": "ČHMÚ-Wetter",
        "es": "Tiempo ČHMÚ"
      },
      "description": {
        "en": "Station readings and the warnings of your district.",
        "fr": "Mesures de la station et alertes de votre district.",
        "de": "Messwerte der Station und Warnungen deines Bezirks.",
        "es": "Datos de la estación y alertas de su distrito."
      },
      "icon": "cloud",
      "settings": [
        {
          "key": "show_station",
          "type": "boolean",
          "label": {
            "en": "Show the station readings",
            "fr": "Afficher les mesures de la station",
            "de": "Messwerte der Station anzeigen",
            "es": "Mostrar los datos de la estación"
          },
          "description": {
            "en": "Temperature, humidity, wind and gusts.",
            "fr": "Température, humidité, vent et rafales.",
            "de": "Temperatur, Feuchte, Wind und Böen.",
            "es": "Temperatura, humedad, viento y ráfagas."
          },
          "required": false,
          "default": true
        },
        {
          "key": "show_warnings",
          "type": "boolean",
          "label": {
            "en": "Show the warnings",
            "fr": "Afficher les alertes",
            "de": "Warnungen anzeigen",
            "es": "Mostrar las alertas"
          },
          "description": {
            "en": "The warnings in force or announced for the district.",
            "fr": "Les alertes en cours ou annoncées pour le district.",
            "de": "Die aktiven oder angekündigten Warnungen des Bezirks.",
            "es": "Las alertas en vigor o anunciadas para el distrito."
          },
          "required": false,
          "default": true
        }
      ]
    }
