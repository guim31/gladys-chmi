{
  "manifest_version": 1,
  "type": "device",
  "name": "ČHMÚ Czech weather",
  "description": {
    "en": "Czech weather from ČHMÚ: nearest station readings and official warnings for your ORP district.",
    "fr": "Météo tchèque du ČHMÚ : mesures de la station proche et alertes officielles de votre district.",
    "de": "Tschechisches Wetter vom ČHMÚ: Messwerte der nächsten Station und amtliche Warnungen deines Bezirks.",
    "es": "Tiempo checo del ČHMÚ: datos de la estación más cercana y alertas oficiales de su distrito."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-chmi:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-chmi/main/cover.png",
  "categories": ["environment"],
  "countries": ["CZ"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "ČHMÚ (Czech Hydrometeorological Institute)",
        "fr": "ČHMÚ (institut hydrométéorologique tchèque)",
        "de": "ČHMÚ (Tschechisches Hydrometeorologisches Institut)",
        "es": "ČHMÚ (Instituto Hidrometeorológico Checo)"
      },
      "description": {
        "en": "Open data of ČHMÚ, the Czech weather service: no account, no key. By default, the integration uses the position of your first Gladys house: the nearest weather station, and the official warnings of its ORP district (one of the 206 districts of Czechia). Not affiliated with ČHMÚ.",
        "fr": "Données ouvertes du ČHMÚ, le service météo tchèque : ni compte, ni clé. Par défaut, l'intégration prend la position de votre première maison Gladys : la station météo la plus proche, et les alertes officielles de son district ORP (l'un des 206 districts de Tchéquie). Sans lien avec le ČHMÚ.",
        "de": "Offene Daten des ČHMÚ, des tschechischen Wetterdienstes: kein Konto, kein Schlüssel. Standardmäßig nutzt die Integration die Position deines ersten Gladys-Zuhauses: die nächste Wetterstation und die amtlichen Warnungen seines ORP-Bezirks (einer der 206 Bezirke Tschechiens). Keine Verbindung zum ČHMÚ.",
        "es": "Datos abiertos del ČHMÚ, el servicio meteorológico checo: sin cuenta ni clave. Por defecto, la integración usa la posición de su primera casa de Gladys: la estación más cercana y las alertas oficiales de su distrito ORP (uno de los 206 distritos de Chequia). Sin relación con el ČHMÚ."
      },
      "links": [
        {
          "url": "https://opendata.chmi.cz/",
          "label": {
            "en": "ČHMÚ open data",
            "fr": "Données ouvertes du ČHMÚ",
            "de": "Offene Daten des ČHMÚ",
            "es": "Datos abiertos del ČHMÚ"
          }
        },
        {
          "url": "https://vystrahy-cr.chmi.cz/",
          "label": {
            "en": "ČHMÚ warnings map",
            "fr": "Carte des alertes du ČHMÚ",
            "de": "Warnkarte des ČHMÚ",
            "es": "Mapa de alertas del ČHMÚ"
          }
        }
      ]
    },
    {
      "key": "house",
      "type": "select",
      "source": "houses",
      "label": {
        "en": "House",
        "fr": "Maison",
        "de": "Zuhause",
        "es": "Casa"
      },
      "description": {
        "en": "The house whose position is used. Empty: the first house with a position.",
        "fr": "La maison dont la position est utilisée. Vide : la première maison qui a une position.",
        "de": "Das Zuhause, dessen Position genutzt wird. Leer: das erste Zuhause mit Position.",
        "es": "La casa cuya posición se usa. Vacío: la primera casa con posición."
      },
      "required": false
    },
    {
      "key": "latitude",
      "type": "string",
      "label": {
        "en": "Latitude (optional)",
        "fr": "Latitude (facultatif)",
        "de": "Breitengrad (optional)",
        "es": "Latitud (opcional)"
      },
      "description": {
        "en": "To use another place than a house. Takes precedence over the house.",
        "fr": "Pour un autre lieu qu'une maison. Prioritaire sur la maison.",
        "de": "Für einen anderen Ort als ein Zuhause. Hat Vorrang vor dem Zuhause.",
        "es": "Para otro lugar que una casa. Tiene prioridad sobre la casa."
      },
      "placeholder": {
        "en": "e.g. 50.08",
        "fr": "ex. 50,08",
        "de": "z. B. 50,08",
        "es": "p. ej. 50,08"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "longitude",
      "type": "string",
      "label": {
        "en": "Longitude (optional)",
        "fr": "Longitude (facultatif)",
        "de": "Längengrad (optional)",
        "es": "Longitud (opcional)"
      },
      "placeholder": {
        "en": "e.g. 14.42",
        "fr": "ex. 14,42",
        "de": "z. B. 14,42",
        "es": "p. ej. 14,42"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "station_id",
      "type": "string",
      "label": {
        "en": "Weather station (optional)",
        "fr": "Station météo (facultatif)",
        "de": "Wetterstation (optional)",
        "es": "Estación meteorológica (opcional)"
      },
      "description": {
        "en": "Id of a ČHMÚ station. Empty: the nearest one. The action below lists them.",
        "fr": "Identifiant d'une station du ČHMÚ. Vide : la plus proche. L'action ci-dessous les liste.",
        "de": "ID einer ČHMÚ-Station. Leer: die nächste. Die Aktion unten listet sie auf.",
        "es": "Identificador de una estación del ČHMÚ. Vacío: la más cercana. La acción de abajo las lista."
      },
      "placeholder": {
        "en": "e.g. 0-20000-0-11518",
        "fr": "ex. 0-20000-0-11518",
        "de": "z. B. 0-20000-0-11518",
        "es": "p. ej. 0-20000-0-11518"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "district",
      "type": "string",
      "label": {
        "en": "Warning district (optional)",
        "fr": "District des alertes (facultatif)",
        "de": "Warnbezirk (optional)",
        "es": "Distrito de alertas (opcional)"
      },
      "description": {
        "en": "Name or 4-digit code of an ORP district. Empty: the one of the location.",
        "fr": "Nom ou code à 4 chiffres d'un district ORP. Vide : celui du lieu.",
        "de": "Name oder 4-stelliger Code eines ORP-Bezirks. Leer: der des Orts.",
        "es": "Nombre o código de 4 cifras de un distrito ORP. Vacío: el del lugar."
      },
      "placeholder": {
        "en": "e.g. Beroun",
        "fr": "ex. Beroun",
        "de": "z. B. Beroun",
        "es": "p. ej. Beroun"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "refresh_minutes",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Fréquence de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "ČHMÚ publishes the station readings once an hour.",
        "fr": "Le ČHMÚ publie les mesures des stations une fois par heure.",
        "de": "Der ČHMÚ veröffentlicht die Messwerte einmal pro Stunde.",
        "es": "El ČHMÚ publica los datos de las estaciones una vez por hora."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 minutes",
            "fr": "30 minutes",
            "de": "30 Minuten",
            "es": "30 minutos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "60 minutes",
            "fr": "60 minutes",
            "de": "60 Minuten",
            "es": "60 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the feature names",
        "fr": "Langue des noms de fonctionnalités",
        "de": "Sprache der Funktionsnamen",
        "es": "Idioma de los nombres de funciones"
      },
      "description": {
        "en": "Used when the devices are created, and for the scene event texts.",
        "fr": "Utilisée à la création des appareils, et pour les textes des événements de scène.",
        "de": "Wird beim Anlegen der Geräte und für die Texte der Szenen-Ereignisse genutzt.",
        "es": "Se usa al crear los dispositivos y para los textos de los eventos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "list_stations",
      "label": {
        "en": "List the nearest stations",
        "fr": "Lister les stations proches",
        "de": "Nächste Stationen anzeigen",
        "es": "Listar las estaciones cercanas"
      },
      "timeout_seconds": 30
    },
    {
      "key": "check_connection",
      "label": {
        "en": "Check the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "warning_issued",
      "label": {
        "en": "New ČHMÚ warning",
        "fr": "Nouvelle alerte du ČHMÚ",
        "de": "Neue ČHMÚ-Warnung",
        "es": "Nueva alerta del ČHMÚ"
      },
      "description": {
        "en": "ČHMÚ issued a weather warning for the district, or raised its level. Fires as soon as it is announced, often hours before it starts.",
        "fr": "Le ČHMÚ a émis une alerte météo pour le district, ou en a relevé le niveau. Se déclenche dès l'annonce, souvent des heures avant le début.",
        "de": "Der ČHMÚ hat eine Wetterwarnung für den Bezirk ausgegeben oder ihre Stufe erhöht. Löst bei der Ankündigung aus, oft Stunden vor Beginn.",
        "es": "El ČHMÚ ha emitido una alerta meteorológica para el distrito, o ha subido su nivel. Se activa en cuanto se anuncia, a menudo horas antes del inicio."
      },
      "fields": [
        {
          "key": "warning_type",
          "type": "multi_select",
          "label": {
            "en": "Warning types",
            "fr": "Types d'alerte",
            "de": "Warnarten",
            "es": "Tipos de alerta"
          },
          "options": [
